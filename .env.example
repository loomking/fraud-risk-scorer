# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API (Evidence Agent LLM) ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── LLM settings ──────────────────────────────────────────────────────────────
# Model used by the Evidence Agent. Change only if Groq changes their naming.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for development. For production: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./fraud_risk.db

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Business cost assumptions (in INR) ───────────────────────────────────────
# These are illustrative assumptions — not researched facts. Document this.
# Cost of a false positive (manual review + customer friction)
FP_COST_INR=50.0
# Cost of a false negative (expected fraud loss, derived from training data)
FN_COST_INR=3000.0

# ── Feature pipeline / model versioning ───────────────────────────────────────
FEATURE_PIPELINE_VERSION=v1.0.0
MODEL_VERSION=v1.0.0
CALIBRATION_VERSION=v1.0.0
THRESHOLD_CONFIG_VERSION=v1.0.0

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_ARTIFACTS_DIR=models
