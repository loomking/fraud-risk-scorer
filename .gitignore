# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyc

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── uv ────────────────────────────────────────────────────────────────────────
# Keep uv.lock committed; ignore the venv uv creates
.python-version

# ── Data — never commit raw CSVs ──────────────────────────────────────────────
data/raw/
data/processed/

# ── Model artifacts ───────────────────────────────────────────────────────────
models/
*.pkl
*.joblib
*.json.gz

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Reports / outputs (keep source, not generated artifacts) ──────────────────
reports/*.png
reports/*.pdf

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.env
secrets.toml

# ── Node / frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
